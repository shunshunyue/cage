{
  "name": "@yss123/cage-http",
  "version": "0.4.1",
  "description": "笼子 HTTP 层：Fastify 插件、路由生成、认证、安全基线",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@yss123/cage-files": "workspace:*",
    "@yss123/cage-admin": "workspace:*",
    "@yss123/cage-approval": "workspace:*",
    "@yss123/cage-kernel": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "lru-cache": "^11.2.1",
    "pg": "^8.16.3",
    "zod": "^4.1.5",
    "kysely": "^0.28.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shunshunyue/cage.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/shunshunyue/cage#readme",
  "bugs": {
    "url": "https://github.com/shunshunyue/cage/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  }
}
