{
  "name": "@yss123/cage-admin",
  "version": "0.4.1",
  "description": "组织模型声明与 /admin 系统管理",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    }
  },
  "files": [
    "dist",
    "ui/index.html",
    "ui/style.css",
    "ui/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@yss123/cage-ai-protocol": "workspace:*",
    "@yss123/cage-kernel": "workspace:*",
    "fastify": "^5.6.0",
    "zod": "^4.1.5",
    "kysely": "^0.28.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shunshunyue/cage.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/shunshunyue/cage#readme",
  "bugs": {
    "url": "https://github.com/shunshunyue/cage/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  }
}
