{
  "name": "cage-monorepo",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/shunshunyue/cage.git" },
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:docker": "docker compose --project-directory examples/purchase-admin --profile test up -d --wait && node --env-file=examples/purchase-admin/.env scripts/test-docker.ts",
    "example:verify": "pnpm --filter @app/purchase-admin verify",
    "docs:errors": "node scripts/build-error-docs.ts",
    "docs:check": "node scripts/build-error-docs.ts --check && node scripts/check-development-docs.ts",
    "docs:examples": "node scripts/check-learning-examples.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "template:sync": "node scripts/sync-template.ts",
    "release:version": "node scripts/release-version.ts",
    "release:pack": "node scripts/release-pack.ts",
    "release:smoke": "node scripts/release-smoke.ts",
    "release:prepare": "turbo run build --filter=./packages/* && pnpm --filter @app/purchase-admin exec cage sync && pnpm --filter @app/purchase-admin gen && pnpm docs:errors && pnpm template:sync && pnpm docs:check && pnpm build && pnpm release:pack"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.9.10",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
