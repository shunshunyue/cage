# 推荐运行 pnpm db:setup 自动生成 .env 和随机密码；不要直接使用占位符连接。
CAGE_POSTGRES_PORT=54329
CAGE_TEST_POSTGRES_PORT=54330
POSTGRES_PASSWORD=<开发集群超级用户密码>
CAGE_TEST_POSTGRES_PASSWORD=<测试集群独立密码>
CAGE_SUPER_DATABASE_URL=postgresql://postgres:<开发集群超级用户密码>@127.0.0.1:54329/postgres
CAGE_APP_DATABASE_URL=postgresql://cage_app:<业务写入密码>@127.0.0.1:54329/cage_dev
CAGE_READ_DATABASE_URL=postgresql://cage_read:<只读密码>@127.0.0.1:54329/cage_dev
CAGE_MIGRATE_DATABASE_URL=postgresql://cage_migrate:<迁移密码>@127.0.0.1:54329/cage_dev
# 只允许指向可丢弃的独立测试集群。
CAGE_TEST_DATABASE_URL=postgresql://postgres:<测试集群独立密码>@127.0.0.1:54330/postgres
CAGE_COOKIE_SECRET=<随机会话签名密钥>
CAGE_STAGE=fake
# 5173 被 Windows 保留时，可改成 15173。端口不会自动漂移，避免访问到错误的服务。
CAGE_WEB_PORT=5173
PORT=3000
HOST=127.0.0.1
